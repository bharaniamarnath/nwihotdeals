# Wordpress - ignore core, configuration, examples, uploads and logs.
# https://github.com/github/gitignore/blob/main/WordPress.gitignore

# Core
#
# Modified
# Note: if you want to stage/commit WP core files
# you can delete this whole section/until Configuration.
src/wp-admin/
src/wp-content/index.php
src/wp-content/languages
src/wp-content/plugins/index.php
src/wp-content/themes/index.php
src/wp-includes/
src/wp-content/ai1wm-backups/
src/index.php
src/license.txt
src/readme.html
src/wp-*.php
src/xmlrpc.php

# Configuration
src/wp-config.php

# Themes
src/wp-content/themes/twenty*/

# Plugin
src/wp-content/plugins/hello.php

# Uploads
src/wp-content/uploads/

# htaccess
/.htaccess
src/.htaccess

#env
/.env

# All plugins
#
# Note: If you wish to whitelist plugins,
# uncomment the next line
#src/wp-content/plugins

# All themes
#
# Note: If you wish to whitelist themes,
# uncomment the next line
src/wp-content/themes/storefront/

# Node dependency directories (Used by Grunt)
src/node_modules/

# OS generated files
ehthumbs.db
Thumbs.db

# Log files and databases
*.log
*.sql
*.sqlite

# ignore compiled files
*.com
*.class
*.dll
*.exe
*.o
*.so

# ignore packaged files
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# All manual backup files
backup/

# All manual backup databases
database/